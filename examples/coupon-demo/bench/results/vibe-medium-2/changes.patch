diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..5e9b3e0 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,50 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  it("accepts a single code in an array", () => {
+    expect(checkout(cart, ["WELCOME10"])).toEqual(checkout(cart, "WELCOME10"));
+  });
+
+  it("treats an empty array as no coupon", () => {
+    expect(checkout(cart, [])).toEqual(checkout(cart));
+  });
+
+  it("stacks coupons in order against the running amount", () => {
+    // 4400 - 10% (440) = 3960, then -500 = 3460
+    expect(checkout(cart, ["WELCOME10", "SAVE5"])).toEqual({
+      subtotalCents: 4400,
+      discountCents: 940,
+      taxCents: 692,
+      totalCents: 4152,
+    });
+    // 4400 - 500 = 3900, then -10% (390) = 3510
+    expect(checkout(cart, ["SAVE5", "WELCOME10"]).discountCents).toBe(890);
+  });
+
+  it("checks a coupon's minimum against the already-discounted amount", () => {
+    // GIFT25 leaves 1900, below SAVE5's 3000 minimum
+    expect(checkout(cart, ["GIFT25", "SAVE5"]).discountCents).toBe(2500);
+  });
+
+  it("never discounts below zero", () => {
+    const small = [{ sku: "pen", priceCents: 1000, qty: 1 }];
+    expect(checkout(small, "GIFT25")).toEqual({
+      subtotalCents: 1000,
+      discountCents: 1000,
+      taxCents: 0,
+      totalCents: 0,
+    });
+  });
+
+  it("rejects a repeated code", () => {
+    expect(() => checkout(cart, ["SAVE5", "SAVE5"])).toThrow("Duplicate coupon");
+  });
+
+  it("rejects the whole checkout if any code is unknown or expired", () => {
+    expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon");
+    expect(() => checkout(cart, ["WELCOME10", "SUMMER15"], new Date("2026-01-01"))).toThrow(
+      "Coupon expired",
+    );
+  });
 });
