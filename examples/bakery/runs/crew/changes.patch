+  it("Sunday 27 December opens until Thursday 24 December 14:00 local (13:00Z)", () => {
+    expect(slotsOn(new Date("2026-12-24T12:59:59Z"), "2026-12-27")).toHaveLength(10);
+    expect(slotsOn(new Date("2026-12-24T13:00:00Z"), "2026-12-27")).toEqual([]);
+  });
+
+  it("Tuesday 29 December closes Sunday 27 December 12:00 (11:00Z), not Monday's non-existent 14:00", () => {
+    expect(slotsOn(new Date("2026-12-27T10:59:59Z"), "2026-12-29")).toHaveLength(22);
+    expect(slotsOn(new Date("2026-12-27T11:00:00Z"), "2026-12-29")).toEqual([]);
+  });
+
+  it("Thursday 7 January closes Tuesday 5 January 14:00 because the 6th is closed", () => {
+    expect(cutoffFor("2027-01-07")).toEqual({ date: "2027-01-05", minutes: 14 * 60 });
+    expect(slotsOn(new Date("2027-01-05T12:59:59Z"), "2027-01-07")).toHaveLength(22);
+    expect(slotsOn(new Date("2027-01-05T13:00:00Z"), "2027-01-07")).toEqual([]);
+  });
+
+  it("Tuesday 5 January closes Sunday 3 January 12:00", () => {
+    expect(cutoffFor("2027-01-05")).toEqual({ date: "2027-01-03", minutes: 12 * 60 });
+  });
+
+  it("Saturday 2 January closes Thursday 31 December 14:00 because 1 January is closed", () => {
+    expect(cutoffFor("2027-01-02")).toEqual({ date: "2026-12-31", minutes: 14 * 60 });
+    expect(slotsOn(new Date("2026-12-31T12:59:59Z"), "2027-01-02")).toHaveLength(22);
+    expect(slotsOn(new Date("2026-12-31T13:00:00Z"), "2027-01-02")).toEqual([]);
+  });
+
+  it("closed dates have no hours even on a normally open weekday", () => {
+    expect(hoursOn("2026-12-25")).toBeNull(); // Friday
+    expect(hoursOn("2026-12-26")).toBeNull(); // Saturday
+    expect(hoursOn("2027-01-06")).toBeNull(); // Wednesday
+    expect(hoursOn("2026-12-24")).toEqual({ open: "07:00", close: "18:00" });
+    expect(hoursOn("2026-12-27")).toEqual({ open: "07:00", close: "12:00" });
+    expect(hoursOn("2026-12-28")).toBeNull(); // Monday
+  });
+});
+
+describe("horizon", () => {
+  it("includes today + 14 when it is a Sunday and nothing after it", () => {
+    const now = new Date("2026-11-01T08:00:00Z"); // Sunday 09:00
+    expect(dates(now).at(-1)).toBe("2026-11-15");
+    expect(slotsOn(now, "2026-11-15")).toHaveLength(10);
+    expect(slotsOn(now, "2026-11-16")).toEqual([]);
+  });
+
+  it("the first slot of a day is 07:00 and the last starts 30 minutes before closing", () => {
+    const now = new Date("2026-11-06T08:00:00Z");
+    for (const [date, last] of [
+      ["2026-11-07", "17:30"],
+      ["2026-11-08", "11:30"],
+      ["2026-11-10", "17:30"],
+    ] as const) {
+      const times = slotsOn(now, date);
+      expect(times[0]).toBe("07:00");
+      expect(times.at(-1)).toBe(last);
+    }
+  });
+
+  it("never offers a slot on a closed day or at/after closing", () => {
+    for (const iso of ["2026-12-14T08:00:00Z", "2026-12-21T08:00:00Z", "2026-12-28T08:00:00Z", "2027-01-04T08:00:00Z"]) {
+      for (const s of generateSlots(new Date(iso))) {
+        const hours = hoursOn(s.date);
+        expect(hours, s.id).not.toBeNull();
+        expect(s.time >= hours!.open && s.time < hours!.close, s.id).toBe(true);
+      }
+    }
+  });
+});
diff --git a/test/slots.test.ts b/test/slots.test.ts
