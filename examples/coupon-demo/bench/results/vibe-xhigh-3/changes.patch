diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..6195732 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,56 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  describe("multiple coupons", () => {
+    it("treats an empty list like no coupon", () => {
+      expect(checkout(cart, [])).toEqual(checkout(cart));
+    });
+
+    it("treats a one-element list like the bare string", () => {
+      expect(checkout(cart, ["WELCOME10"])).toEqual(checkout(cart, "WELCOME10"));
+    });
+
+    it("stacks discounts, each computed on the subtotal", () => {
+      expect(checkout(cart, ["WELCOME10", "SAVE5"])).toEqual({
+        subtotalCents: 4400,
+        discountCents: 940,
+        taxCents: 692,
+        totalCents: 4152,
+      });
+    });
+
+    it("gives the same result regardless of code order", () => {
+      expect(checkout(cart, ["SAVE5", "WELCOME10"])).toEqual(
+        checkout(cart, ["WELCOME10", "SAVE5"]),
+      );
+    });
+
+    it("applies a repeated code only once", () => {
+      expect(checkout(cart, ["WELCOME10", "WELCOME10"]).discountCents).toBe(440);
+    });
+
+    it("caps the combined discount at the subtotal", () => {
+      const smallCart = [{ sku: "mug", priceCents: 1200, qty: 2 }];
+      expect(checkout(smallCart, ["GIFT25", "WELCOME10"])).toEqual({
+        subtotalCents: 2400,
+        discountCents: 2400,
+        taxCents: 0,
+        totalCents: 0,
+      });
+    });
+
+    it("rejects the whole checkout if any code is unknown", () => {
+      expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon: NOPE");
+    });
+
+    it("rejects the whole checkout if any code is expired", () => {
+      const after = new Date("2025-10-01");
+      expect(() => checkout(cart, ["WELCOME10", "SUMMER15"], after)).toThrow(
+        "Coupon expired: SUMMER15",
+      );
+      const before = new Date("2025-08-01");
+      expect(checkout(cart, ["WELCOME10", "SUMMER15"], before).discountCents).toBe(1100);
+    });
+  });
 });
