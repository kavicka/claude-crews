-export function checkout(items: Item[], code?: string, now: Date = new Date()): Receipt {
+/**
+ * Coupons are applied in the order given, each against the amount left after
+ * the previous ones (so minimums and percentages see the running amount).
+ * A coupon never discounts more than what remains, so the total can't go
+ * negative. Repeating a code is rejected.
+ */
+export function checkout(
+  items: Item[],
+  codes?: string | string[],
+  now: Date = new Date(),
+): Receipt {
+  const codeList = Array.isArray(codes) ? codes : codes ? [codes] : [];
+  const seen = new Set<string>();
+  for (const code of codeList) {
+    if (seen.has(code)) throw new Error(`Duplicate coupon: ${code}`);
+    seen.add(code);
+  }
+  // Validate every code up front so one bad code fails the whole checkout.
+  const coupons = codeList.map((code) => findCoupon(code, now));
+
   const subtotalCents = subtotal(items);
-  const discountCents = code ? discountFor(findCoupon(code, now), subtotalCents) : 0;
-  const afterDiscount = subtotalCents - discountCents;
-  const taxCents = Math.round(afterDiscount * TAX_RATE);
+  let remaining = subtotalCents;
+  for (const coupon of coupons) {
+    remaining -= Math.min(discountFor(coupon, remaining), remaining);
+  }
+  const discountCents = subtotalCents - remaining;
+  const taxCents = Math.round(remaining * TAX_RATE);
   return {
     subtotalCents,
     discountCents,
     taxCents,
-    totalCents: afterDiscount + taxCents,
+    totalCents: remaining + taxCents,
   };
 }
