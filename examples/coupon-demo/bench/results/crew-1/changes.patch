+      expect(r.totalCents).toBe(1333);
+      expect(checkout(single(1235), "WELCOME10").discountCents).toBe(124);
+      for (const price of [1234, 1235, 1005]) {
+        const rec = checkout(single(price), ["WELCOME10", "SUMMER15"], aug);
+        for (const v of Object.values(rec)) expect(Number.isInteger(v)).toBe(true);
+      }
+    });
+
+    it("applies a single non-expired SUMMER15", () => {
+      expect(checkout(cart, "SUMMER15", aug).discountCents).toBe(660);
+    });
+
+    it("rejects duplicate coupons", () => {
+      expect(() => checkout(cart, ["SAVE5", "SAVE5"])).toThrow("Duplicate coupon: SAVE5");
+    });
+
+    it("reports the first problem in input order (duplicate before a later unknown)", () => {
+      expect(() => checkout(cart, ["SAVE5", "SAVE5", "NOPE"])).toThrow("Duplicate coupon: SAVE5");
+    });
+
+    it("rejects an unknown coupon among valid ones", () => {
+      expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon: NOPE");
+    });
+
+    it("rejects an expired coupon among valid ones", () => {
+      expect(() => checkout(cart, ["WELCOME10", "SUMMER15"], oct)).toThrow(
+        "Coupon expired: SUMMER15",
+      );
+    });
+
+    it("reports the first invalid code in input order", () => {
+      expect(() => checkout(cart, ["NOPE", "SUMMER15"], oct)).toThrow("Unknown coupon: NOPE");
+    });
+
+    it("reports expired before duplicate for a repeated expired code", () => {
+      expect(() => checkout(cart, ["SUMMER15", "SUMMER15"], oct)).toThrow(
+        "Coupon expired: SUMMER15",
+      );
+    });
+
+    it("accepts a readonly array without mutating it", () => {
+      const codes: readonly string[] = Object.freeze(["SAVE5", "WELCOME10"]);
+      expect(checkout(cart, codes).discountCents).toBe(940);
+      expect(codes).toEqual(["SAVE5", "WELCOME10"]);
+    });
+  });
 });
