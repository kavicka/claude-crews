@@ -0,0 +1,115 @@
+process.env.TZ = "America/New_York";
+
+import { describe, expect, it } from "vitest";
+import { addDays, cutoffFor, formatSlot, generateSlots, localNow } from "../src/slots.js";
+
+/** Friday 2026-11-06 09:00 in Bratislava. */
+const T0 = new Date("2026-11-06T08:00:00Z");
+
+function times(now: Date, date: string): string[] {
+  return generateSlots(now)
+    .filter((s) => s.date === date)
+    .map((s) => s.time);
+}
+
+describe("process time zone", () => {
+  it("really runs in New York, so nothing below depends on the server zone", () => {
+    expect(new Date("2026-11-06T08:00:00Z").getHours()).toBe(3);
+  });
+});
+
+describe("localNow", () => {
+  it("converts to Bratislava wall time", () => {
+    expect(localNow(T0)).toEqual({ date: "2026-11-06", minutes: 9 * 60 });
+    expect(localNow(new Date("2026-11-06T23:30:00Z"))).toEqual({ date: "2026-11-07", minutes: 30 });
+  });
+
+  it("follows the spring DST jump", () => {
+    expect(localNow(new Date("2027-03-28T01:30:00Z"))).toEqual({ date: "2027-03-28", minutes: 210 });
+  });
+});
+
+describe("addDays", () => {
+  it("crosses months, years and DST changes by calendar day", () => {
+    expect(addDays("2026-12-31", 1)).toBe("2027-01-01");
+    expect(addDays("2027-03-27", 1)).toBe("2027-03-28");
+    expect(addDays("2027-03-28", 1)).toBe("2027-03-29");
+    expect(addDays("2027-10-31", -1)).toBe("2027-10-30");
+  });
+});
+
+describe("generateSlots", () => {
+  const all = Array.from({ length: 22 }, (_, i) => `${String(7 + Math.floor(i / 2)).padStart(2, "0")}:${i % 2 ? "30" : "00"}`);
+
+  it("offers no same-day slots", () => {
+    expect(times(T0, "2026-11-06")).toEqual([]);
+  });
+
+  it("offers tomorrow 07:00–17:30 before Friday's 14:00 cut-off", () => {
+    expect(times(T0, "2026-11-07")).toEqual(all);
+  });
+
+  it("offers Sunday 07:00–11:30, nothing on Monday, Tuesday again", () => {
+    expect(times(T0, "2026-11-08")).toEqual(all.slice(0, 10));
+    expect(times(T0, "2026-11-09")).toEqual([]);
+    expect(times(T0, "2026-11-10")).toEqual(all);
+  });
+
+  it("runs through today + 14 days", () => {
+    const dates = generateSlots(T0).map((s) => s.date);
+    expect(dates.at(-1)).toBe("2026-11-20");
+    expect(dates).not.toContain("2026-11-21");
+  });
+
+  it("uses slot ids in local wall time", () => {
+    expect(generateSlots(T0)[0]).toEqual({ id: "2026-11-07T07:00", date: "2026-11-07", time: "07:00" });
+  });
+
+  it("closes Saturday after Friday 14:00", () => {
+    const at = new Date("2026-11-06T13:30:00Z");
+    expect(times(at, "2026-11-07")).toEqual([]);
+    expect(times(at, "2026-11-08")).toHaveLength(10);
+  });
+
+  it("closes Tuesday at Sunday's 12:00 closing time", () => {
+    expect(times(new Date("2026-11-08T10:59:00Z"), "2026-11-10")).toHaveLength(22);
+    expect(times(new Date("2026-11-08T11:00:00Z"), "2026-11-10")).toEqual([]);
+  });
+
+  it("skips closed dates", () => {
+    const dates = new Set([
+      ...generateSlots(new Date("2026-12-14T08:00:00Z")).map((s) => s.date),
+      ...generateSlots(new Date("2026-12-28T08:00:00Z")).map((s) => s.date),
+    ]);
+    expect(dates).toContain("2026-12-24");
+    expect(dates).toContain("2026-12-27");
+    for (const closed of ["2026-12-25", "2026-12-26", "2027-01-01", "2027-01-06"]) expect(dates).not.toContain(closed);
+  });
+
+  it("generates exactly 10 slots on the DST-change Sundays", () => {
+    expect(times(new Date("2027-03-25T08:00:00Z"), "2027-03-28")).toHaveLength(10);
+    expect(times(new Date("2027-10-28T08:00:00Z"), "2027-10-31")).toHaveLength(10);
+  });
+});
+
+describe("cutoffFor", () => {
+  it("is 14:00 the day before on a normal weekday", () => {
+    expect(cutoffFor("2026-11-11")).toEqual({ date: "2026-11-10", minutes: 14 * 60 });
+  });
+
+  it("is Sunday's closing time for Tuesday", () => {
+    expect(cutoffFor("2026-11-10")).toEqual({ date: "2026-11-08", minutes: 12 * 60 });
+  });
+
+  it("skips closed dates", () => {
+    expect(cutoffFor("2026-12-27")).toEqual({ date: "2026-12-24", minutes: 14 * 60 });
+    expect(cutoffFor("2027-01-02")).toEqual({ date: "2026-12-31", minutes: 14 * 60 });
+  });
+});
+
+describe("formatSlot", () => {
+  it("formats in both languages", () => {
+    expect(formatSlot("2026-11-07T09:00", "en")).toBe("Saturday 7 November, 09:00");
+    expect(formatSlot("2026-11-07T09:00", "sk")).toBe("sobota 7. novembra, 09:00");
+  });
+});
