+import request from "supertest";
+import { createApp } from "../src/app.js";
+import type { Mail, Mailer } from "../src/mailer.js";
+import { InMemoryOrderStore, newFormToken, type Order, type OrderStore } from "../src/orders.js";
+
+export class FakeMailer implements Mailer {
+  sent: Mail[] = [];
+  /** Indexes of send() calls (0-based) that throw. */
+  failOn = new Set<number>();
+  private calls = 0;
+  async send(mail: Mail) {
+    if (this.failOn.has(this.calls++)) throw new Error("SMTP down");
+    this.sent.push(mail);
+  }
+}
+
+/** Friday 2026-11-06 09:00 in Bratislava. */
+export const T0 = new Date("2026-11-06T08:00:00Z");
+/** Saturday 2026-11-07 09:00, the first slot on offer at T0. */
+export const SLOT = "2026-11-07T09:00";
+
+export function setup({ now = T0, orders = new InMemoryOrderStore() }: { now?: Date; orders?: OrderStore } = {}) {
+  const mailer = new FakeMailer();
+  return { mailer, orders, app: createApp({ mailer, orders, now: () => now }) };
+}
+
+export type TestApp = ReturnType<typeof setup>["app"];
+
+/**
+ * A valid order form as the browser posts it: empty honeypot and a fresh form token per call,
+ * so two calls are two separate orders while posting the same object twice is a double submit.
+ */
+export function orderForm(overrides: Record<string, string> = {}): Record<string, string> {
+  return {
+    "qty_kvaskovy-chlieb": "2",
+    qty_croissant: "3",
+    slot: SLOT,
+    name: "Eva",
+    email: "eva@example.com",
+    phone: "",
+    note: "Sliced, please",
+    website: "",
+    token: newFormToken(),
+    ...overrides,
+  };
+}
+
+export function postOrder(app: TestApp, form: Record<string, string> | string, lang: string | null = "en") {
+  return request(app)
+    .post(lang === null ? "/order" : `/order?lang=${lang}`)
+    .type("form")
+    .send(form);
+}
+
+/** Order id from a successful order redirect. */
+export function orderId(res: request.Response): string {
+  const id = /[?&]order=([0-9A-F]{8})#order$/.exec(res.headers.location ?? "")?.[1];
+  if (!id) throw new Error(`not an order redirect: ${res.status} ${res.headers.location}`);
+  return id;
+}
+
+let seq = 0;
+/** A stored order with a unique id and email. Ids are 8 hex characters starting with "E". */
+export function storedOrder(overrides: Partial<Order> = {}): Order {
+  seq++;
+  return {
+    id: `E${String(seq).padStart(7, "0")}`,
+    slot: SLOT,
+    lines: [{ productId: "bageta", qty: 1, unitPriceCents: 190 }],
+    totalCents: 190,
+    name: "Someone",
+    email: `someone${seq}@example.com`,
+    lang: "sk",
+    status: "open",
+    createdAt: T0.toISOString(),
+    ...overrides,
+  };
+}
+
+/** Text of the first role="alert" paragraph on the page, or undefined. */
+export function alertText(html: string): string | undefined {
+  return /<p role="alert">([^<]*)<\/p>/.exec(html)?.[1];
+}
