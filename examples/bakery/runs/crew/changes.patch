+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import request from "supertest";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createApp } from "../src/app.js";
+import {
+  FileOrderStore,
+  InMemoryOrderStore,
+  isResubmission,
+  newFormToken,
+  type Order,
+  type OrderStore,
+  type ReserveLimits,
+} from "../src/orders.js";
+import { alertText, FakeMailer, orderForm, orderId, postOrder, setup, SLOT, storedOrder, T0 } from "./helpers.js";
+
+const limits: ReserveLimits = { capacity: 8, maxOpenPerEmail: 3, nowSlot: "2026-11-06T09:00" };
+const TOKEN_FIELD = /<input type="hidden" name="token" value="([^"]*)">/;
+
+beforeEach(() => {
+  vi.spyOn(console, "error").mockImplementation(() => {});
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+/** A stored order and a candidate that repeats it, for the content rule. */
+function pair(token = newFormToken()) {
+  const stored = storedOrder({
+    token,
+    email: "jan@example.com",
+    lines: [
+      { productId: "bageta", qty: 2, unitPriceCents: 190 },
+      { productId: "croissant", qty: 3, unitPriceCents: 180 },
+    ],
+  });
+  return { stored, candidate: { token, slot: stored.slot, email: stored.email, lines: structuredClone(stored.lines) } };
+}
+
+describe("isResubmission: the content rule", () => {
+  it("matches the same token, slot, email and lines", () => {
+    const { stored, candidate } = pair();
+    expect(isResubmission(stored, candidate)).toBe(true);
+  });
+
+  it("ignores email case and surrounding spaces, but not a different mailbox", () => {
+    const { stored, candidate } = pair();
+    expect(isResubmission(stored, { ...candidate, email: "  JAN@Example.COM " })).toBe(true);
+    expect(isResubmission(stored, { ...candidate, email: "jan2@example.com" })).toBe(false);
+    expect(isResubmission(stored, { ...candidate, email: "ja.n@example.com" })).toBe(false);
+    expect(isResubmission(stored, { ...candidate, email: "jan@example.org" })).toBe(false);
+  });
+
+  it("ignores the order of the lines", () => {
+    const { stored, candidate } = pair();
+    expect(isResubmission(stored, { ...candidate, lines: [...candidate.lines].reverse() })).toBe(true);
+  });
+
+  it("ignores the unit price (prices come from the server, not the form)", () => {
+    const { stored, candidate } = pair();
+    const repriced = candidate.lines.map((l) => ({ ...l, unitPriceCents: 1 }));
+    expect(isResubmission(stored, { ...candidate, lines: repriced })).toBe(true);
+  });
+
+  it.each([
+    ["a changed quantity", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, lines: [{ ...c.lines[0]!, qty: 3 }, c.lines[1]!] })],
+    ["a missing line", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, lines: [c.lines[0]!] })],
+    ["an extra line", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, lines: [...c.lines, { productId: "makovy-zavin", qty: 1, unitPriceCents: 350 }] })],
+    ["a swapped product with the same quantity", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, lines: [{ ...c.lines[0]!, productId: "rascovy-chlieb" }, c.lines[1]!] })],
+    ["a swapped quantity between products", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, lines: [{ ...c.lines[0]!, qty: 3 }, { ...c.lines[1]!, qty: 2 }] })],
+    ["another slot", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, slot: "2026-11-07T09:30" })],
+    ["another day", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, slot: "2026-11-08T09:00" })],
+    ["another token", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, token: newFormToken() })],
+    ["no token", (c: ReturnType<typeof pair>["candidate"]) => ({ ...c, token: undefined })],
+  ])("does not match %s", (_, change) => {
+    const { stored, candidate } = pair();
+    expect(isResubmission(stored, change(candidate))).toBe(false);
+  });
+
+  it("never matches a cancelled order, or a stored order without a token", () => {
+    const { stored, candidate } = pair();
+    expect(isResubmission({ ...stored, status: "cancelled" }, candidate)).toBe(false);
+    expect(isResubmission({ ...stored, token: undefined }, candidate)).toBe(false);
+    expect(isResubmission({ ...stored, token: undefined }, { ...candidate, token: undefined })).toBe(false);
+  });
+});
+
+describe("findDuplicate and reserve agree", () => {
+  type Candidate = Parameters<OrderStore["findDuplicate"]>[0];
+  const variants: [string, (c: Candidate) => Candidate][] = [
+    ["identical", (c) => c],
+    ["email case and spaces", (c) => ({ ...c, email: " JAN@EXAMPLE.COM" })],
+    ["reordered lines", (c) => ({ ...c, lines: [...c.lines].reverse() })],
+    ["other slot", (c) => ({ ...c, slot: "2026-11-07T09:30" })],
+    ["other email", (c) => ({ ...c, email: "x@example.com" })],
+    ["other quantity", (c) => ({ ...c, lines: [{ ...c.lines[0]!, qty: 9 }, c.lines[1]!] })],
+    ["other token", (c) => ({ ...c, token: newFormToken() })],
+    ["no token", (c) => ({ ...c, token: undefined })],
+  ];
+
+  function stores(stored: Order[], dir: string): [string, () => OrderStore][] {
+    let n = 0;
+    return [
+      ["in memory", () => new InMemoryOrderStore(structuredClone(stored))],
+      [
+        "file",
+        () => {
+          const path = join(dir, `orders${n++}.json`);
+          writeFileSync(path, JSON.stringify(stored));
+          return new FileOrderStore(path);
+        },
+      ],
+    ];
+  }
+
+  let dir: string;
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), "kvasok-qa4-"));
+  });
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  it.each([["open"], ["cancelled"]] as const)("for every variant against a %s stored order", (status) => {
+    const { stored, candidate } = pair();
+    const open = { ...stored, status };
+    for (const [storeName, make] of stores([open], dir)) {
+      for (const [name, change] of variants) {
+        const c = change(candidate);
+        const early = make().findDuplicate(c)?.id;
+        const atomic = make().reserve({ ...storedOrder({ ...c, id: "F0000001" }), ...c }, limits);
+        const label = `${storeName} / ${name} / ${status}`;
+        if (early) expect(atomic, label).toMatchObject({ status: "duplicate", order: { id: early } });
+        else expect(typeof atomic, label).toBe("string");
+      }
+    }
+  });
+
+  /** The first findDuplicate call after `blind = true` finds nothing, as if the order appeared a moment later. */
