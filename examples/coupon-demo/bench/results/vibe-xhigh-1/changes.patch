diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..0d77e34 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,72 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  it("treats an empty code as no coupon", () => {
+    expect(checkout(cart, "").discountCents).toBe(0);
+  });
+
+  describe("multiple codes", () => {
+    it("stacks discounts, each computed on the subtotal", () => {
+      expect(checkout(cart, ["WELCOME10", "SAVE5"])).toEqual({
+        subtotalCents: 4400,
+        discountCents: 940,
+        taxCents: 692,
+        totalCents: 4152,
+      });
+    });
+
+    it("gives the same result regardless of code order", () => {
+      expect(checkout(cart, ["SAVE5", "WELCOME10"])).toEqual(
+        checkout(cart, ["WELCOME10", "SAVE5"]),
+      );
+    });
+
+    it("matches the single-string form for a one-element array", () => {
+      expect(checkout(cart, ["WELCOME10"])).toEqual(checkout(cart, "WELCOME10"));
+    });
+
+    it("treats an empty array as no coupon", () => {
+      expect(checkout(cart, [])).toEqual(checkout(cart));
+    });
+
+    it("checks each coupon's minimum against the pre-discount subtotal", () => {
+      // 10% off 3000 would leave 2700, below SAVE5's 3000 minimum,
+      // but SAVE5 still applies because it is checked against the subtotal.
+      const small = [{ sku: "tee", priceCents: 3000, qty: 1 }];
+      expect(checkout(small, ["WELCOME10", "SAVE5"]).discountCents).toBe(800);
+    });
+
+    it("caps the combined discount at the subtotal", () => {
+      const small = [{ sku: "tee", priceCents: 3000, qty: 1 }];
+      expect(checkout(small, ["GIFT25", "SAVE5", "WELCOME10"])).toEqual({
+        subtotalCents: 3000,
+        discountCents: 3000,
+        taxCents: 0,
+        totalCents: 0,
+      });
+    });
+
+    it("rejects the checkout if any code is unknown", () => {
+      expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon: NOPE");
+    });
+
+    it("rejects the checkout if any code is expired", () => {
+      const now = new Date("2025-10-01");
+      expect(() => checkout(cart, ["WELCOME10", "SUMMER15"], now)).toThrow(
+        "Coupon expired: SUMMER15",
+      );
+    });
+
+    it("applies a not-yet-expired code alongside others", () => {
+      const now = new Date("2025-08-01");
+      expect(checkout(cart, ["WELCOME10", "SUMMER15"], now).discountCents).toBe(1100);
+    });
+
+    it("rejects a repeated code", () => {
+      expect(() => checkout(cart, ["WELCOME10", "WELCOME10"])).toThrow(
+        "Duplicate coupon: WELCOME10",
+      );
+    });
+  });
 });
