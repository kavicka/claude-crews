diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..b19cb98 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,51 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  it("accepts an array with a single code", () => {
+    expect(checkout(cart, ["WELCOME10"]).discountCents).toBe(440);
+  });
+
+  it("treats an empty array like no coupon", () => {
+    expect(checkout(cart, [])).toEqual(checkout(cart));
+  });
+
+  it("stacks percent then fixed regardless of input order", () => {
+    // 4400 - 10% = 3960, then -500 = 3460 -> discount 940
+    const a = checkout(cart, ["WELCOME10", "SAVE5"]);
+    const b = checkout(cart, ["SAVE5", "WELCOME10"]);
+    expect(a).toEqual(b);
+    expect(a).toEqual({
+      subtotalCents: 4400,
+      discountCents: 940,
+      taxCents: 692,
+      totalCents: 4152,
+    });
+  });
+
+  it("checks minimums against the original subtotal", () => {
+    // After 10% off the cart is 2880, but SAVE5's 3000 minimum uses the 3200 subtotal.
+    const small = [{ sku: "mug", priceCents: 1600, qty: 2 }];
+    expect(checkout(small, ["WELCOME10", "SAVE5"]).discountCents).toBe(820);
+  });
+
+  it("never discounts below zero", () => {
+    expect(checkout(cart, ["GIFT25", "SAVE5", "WELCOME10"])).toEqual({
+      subtotalCents: 4400,
+      discountCents: 3440,
+      taxCents: 192,
+      totalCents: 1152,
+    });
+    const tiny = [{ sku: "pin", priceCents: 1000, qty: 1 }];
+    expect(checkout(tiny, ["GIFT25"]).totalCents).toBe(0);
+  });
+
+  it("rejects duplicate codes", () => {
+    expect(() => checkout(cart, ["WELCOME10", "WELCOME10"])).toThrow("Duplicate coupon");
+  });
+
+  it("rejects the whole checkout if any code is invalid", () => {
+    expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon");
+    expect(() => checkout(cart, ["SUMMER15"], new Date("2026-01-01"))).toThrow("Coupon expired");
+  });
 });
