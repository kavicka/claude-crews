+import request from "supertest";
+import { afterEach, beforeEach, describe, expect, it, vi, type MockInstance } from "vitest";
+import { SHOP_EMAIL } from "../src/mailer.js";
+import { InMemoryOrderStore } from "../src/orders.js";
+import { alertText, orderForm, orderId, postOrder, setup, SLOT, storedOrder, T0 } from "./helpers.js";
+
+const CONTACT_OK = "email=eva%40example.com&message=Hello";
+
+describe("repeated form fields (array values in the body)", () => {
+  // Regression: express.urlencoded({ extended: false }) turns a repeated field into an array. /contact used to
+  // pass it straight to escapeHtml() outside its try, so the async handler rejected, Express 4 never answered and
+  // the request hung (on Node >= 15 the unhandled rejection would also kill the process). The short timeouts keep
+  // a regression from stalling the suite.
+  it("POST /contact with a repeated field is a 400 with the form re-rendered, not a 500 or a hang", async () => {
+    const { app, mailer } = setup();
+    const res = await request(app).post("/contact").type("form").send(`name=Eva&name=Adam&${CONTACT_OK}`).timeout(1500);
+    expect(res.status).toBe(400);
+    expect(res.text).toContain('role="alert"');
+    expect(mailer.sent).toHaveLength(0);
