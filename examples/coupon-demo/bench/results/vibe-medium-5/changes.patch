diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..bb8d56d 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,48 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  describe("multiple codes", () => {
+    it("accepts an empty array", () => {
+      expect(checkout(cart, []).discountCents).toBe(0);
+    });
+
+    it("treats a one-element array like a single string", () => {
+      expect(checkout(cart, ["WELCOME10"])).toEqual(checkout(cart, "WELCOME10"));
+    });
+
+    it("stacks percent then fixed, regardless of input order", () => {
+      // 4400 - 10% = 3960, then - 500 = 3460
+      const a = checkout(cart, ["WELCOME10", "SAVE5"]);
+      const b = checkout(cart, ["SAVE5", "WELCOME10"]);
+      expect(a.discountCents).toBe(940);
+      expect(b).toEqual(a);
+      expect(a.totalCents).toBe(3460 + 692);
+    });
+
+    it("checks minimums against the original subtotal", () => {
+      // 3200 qualifies for SAVE5 even though 10% off drops it to 2880
+      const small = [{ sku: "x", priceCents: 3200, qty: 1 }];
+      expect(checkout(small, ["WELCOME10", "SAVE5"]).discountCents).toBe(820);
+    });
+
+    it("never discounts below zero", () => {
+      const r = checkout(cart, ["GIFT25", "SAVE5", "WELCOME10"]);
+      // 4400 -10% = 3960, -2500 = 1460, -500 = 960
+      expect(r.discountCents).toBe(3440);
+      const tiny = [{ sku: "x", priceCents: 1000, qty: 1 }];
+      expect(checkout(tiny, ["GIFT25"]).totalCents).toBe(0);
+    });
+
+    it("rejects duplicate codes", () => {
+      expect(() => checkout(cart, ["SAVE5", "SAVE5"])).toThrow("Duplicate coupon");
+    });
+
+    it("rejects the whole checkout if any code is invalid", () => {
+      expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon");
+      expect(() =>
+        checkout(cart, ["WELCOME10", "SUMMER15"], new Date("2026-01-01")),
+      ).toThrow("Coupon expired");
+    });
+  });
 });
