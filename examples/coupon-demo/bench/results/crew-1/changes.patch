+        discountCents: 1000,
+        taxCents: 0,
+        totalCents: 0,
+      });
+      const r = checkout(single(2600), ["GIFT25", "WELCOME10"]);
+      expect(r.discountCents).toBe(2600);
+      expect(r.taxCents).toBe(0);
+      expect(r.totalCents).toBe(0);
+    });
+
+    it("rounds percent discounts and returns integers", () => {
