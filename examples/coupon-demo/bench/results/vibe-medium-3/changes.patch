diff --git a/src/checkout.test.ts b/src/checkout.test.ts
index a2a65bc..a0f61e1 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,44 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  it("accepts an array with a single code", () => {
+    expect(checkout(cart, ["WELCOME10"])).toEqual(checkout(cart, "WELCOME10"));
+  });
+
+  it("treats an empty array like no coupon", () => {
+    expect(checkout(cart, [])).toEqual(checkout(cart));
+  });
+
+  it("stacks multiple coupons against the subtotal", () => {
+    const r = checkout(cart, ["WELCOME10", "SAVE5"]);
+    expect(r.discountCents).toBe(940);
+    expect(r.taxCents).toBe(692);
+    expect(r.totalCents).toBe(4152);
+  });
+
+  it("is independent of code order", () => {
+    expect(checkout(cart, ["SAVE5", "WELCOME10"])).toEqual(checkout(cart, ["WELCOME10", "SAVE5"]));
+  });
+
+  it("caps the combined discount at the subtotal", () => {
+    const small = [{ sku: "pin", priceCents: 2000, qty: 1 }];
+    const r = checkout(small, ["GIFT25", "WELCOME10"]);
+    expect(r.discountCents).toBe(2000);
+    expect(r.totalCents).toBe(0);
+  });
+
+  it("rejects a duplicated code", () => {
+    expect(() => checkout(cart, ["WELCOME10", "WELCOME10"])).toThrow("Duplicate coupon");
+  });
+
+  it("rejects the whole checkout if any code is unknown", () => {
+    expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon");
+  });
+
+  it("rejects an expired code in a list", () => {
+    expect(() => checkout(cart, ["WELCOME10", "SUMMER15"], new Date("2026-01-01"))).toThrow(
+      "Coupon expired",
+    );
+  });
 });
