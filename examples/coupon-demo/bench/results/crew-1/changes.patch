+      expect(checkout(cart, ["SAVE5", "WELCOME10"])).toEqual(expected);
+    });
+
+    it("stacks two percent coupons when the second is still valid", () => {
+      const r = checkout(cart, ["WELCOME10", "SUMMER15"], aug);
+      expect(r.discountCents).toBe(1034);
+      expect(r.taxCents).toBe(673);
+      expect(r.totalCents).toBe(4039);
+    });
+
+    it("orders percent coupons by catalog order and compounds them", () => {
+      for (const codes of [
+        ["WELCOME10", "SUMMER15"],
+        ["SUMMER15", "WELCOME10"],
+      ]) {
+        const r = checkout(single(1005), codes, aug);
+        expect(r.discountCents).toBe(237);
+        expect(r.taxCents).toBe(154);
+        expect(r.totalCents).toBe(922);
+      }
+    });
+
+    it("checks minSubtotal against the original subtotal", () => {
+      const r = checkout(single(3200), ["WELCOME10", "SAVE5"]);
+      expect(r.discountCents).toBe(820);
+      expect(r.taxCents).toBe(476);
+      expect(r.totalCents).toBe(2856);
+    });
+
+    it("gives no discount when below a fixed coupon minimum", () => {
+      expect(checkout(single(2000), ["SAVE5"]).discountCents).toBe(0);
+    });
+
+    it("clamps a fixed discount to the remaining amount", () => {
+      expect(checkout(single(1000), "GIFT25")).toEqual({
