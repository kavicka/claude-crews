+++ b/src/orders.ts
@@ -0,0 +1,279 @@
+import { randomBytes } from "node:crypto";
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+import { z } from "zod";
+import { fill, t, type Lang } from "./i18n.js";
+import type { Mail } from "./mailer.js";
+import { formatPrice, MENU, productName } from "./menu.js";
+import { formatSlot, SLOT_ID_RE } from "./slots.js";
+
+export type OrderStatus = "open" | "cancelled";
+
+export interface OrderLine {
+  productId: string;
+  qty: number;
+  unitPriceCents: number;
+}
+
+export interface Order {
+  /** 8 uppercase hex characters. */
+  id: string;
+  /** Slot id "YYYY-MM-DDTHH:MM", local time. */
+  slot: string;
+  lines: OrderLine[];
+  totalCents: number;
+  name: string;
+  email: string;
+  phone?: string;
+  note?: string;
+  lang: Lang;
+  status: OrderStatus;
+  /** ISO instant. */
+  createdAt: string;
+  /** Random token of the form that placed the order; a resubmission with the same token is not a new order. */
+  token?: string;
+}
+
+export const ORDER_ID_RE = /^[0-9A-F]{8}$/;
+export const FORM_TOKEN_RE = /^[0-9a-f]{32}$/;
+
+export function newOrderId(): string {
+  return randomBytes(4).toString("hex").toUpperCase();
+}
+
+/** One-time token rendered into each order form, used to recognise double submissions. */
+export function newFormToken(): string {
+  return randomBytes(16).toString("hex");
+}
+
+/** Prices the requested quantities from MENU (the only source of prices). Zero quantities are left out. */
+export function priceLines(quantities: Record<string, number>): { lines: OrderLine[]; totalCents: number } {
+  const lines = MENU.filter((p) => (quantities[p.id] ?? 0) > 0).map((p) => ({
+    productId: p.id,
+    qty: quantities[p.id]!,
+    unitPriceCents: p.priceCents,
+  }));
+  return { lines, totalCents: lines.reduce((sum, l) => sum + l.qty * l.unitPriceCents, 0) };
+}
+
+function lineText(line: OrderLine, lang: Lang): string {
+  return `${line.qty}× ${productName(line.productId, lang)} — ${formatPrice(line.qty * line.unitPriceCents, lang)}`;
+}
+
+/** Mail for the shop, always in Slovak. The subject carries no user input. */
+export function shopOrderMail(order: Order, to: string): Mail {
+  const text = [
+    `Objednávka ${order.id}`,
+    `Vyzdvihnutie: ${formatSlot(order.slot, "sk")}`,
+    "",
+    ...order.lines.map((l) => lineText(l, "sk")),
+    `Spolu: ${formatPrice(order.totalCents, "sk")} (platí pri vyzdvihnutí)`,
+    "",
+    `Meno: ${order.name}`,
+    `E-mail: ${order.email}`,
+    `Telefón: ${order.phone ?? "—"}`,
+    `Jazyk: ${order.lang}`,
+    "",
+    "Poznámka:",
+    order.note ?? "—",
+  ].join("\n");
+  return { to, replyTo: order.email, subject: `Objednávka ${order.id} — ${formatSlot(order.slot, "sk")}`, text };
+}
+
+/** Confirmation for the customer, in their language. Leaves out the free-text note. */
+export function customerOrderMail(order: Order): Mail {
+  const m = t(order.lang);
+  const slot = formatSlot(order.slot, order.lang);
+  const text = [
+    m.mailIntro,
+    "",
+    fill(m.mailOrderNumber, { id: order.id }),
+    fill(m.orderPickup, { slot }),
+    "",
+    ...order.lines.map((l) => lineText(l, order.lang)),
+    `${m.total}: ${formatPrice(order.totalCents, order.lang)}`,
+    m.payAtPickup,
+    "",
+    m.mailFooter,
+  ].join("\n");
+  return { to: order.email, subject: fill(m.mailSubject, { id: order.id, slot }), text };
+}
+
+export interface ReserveLimits {
+  /** Max open orders per slot. */
+  capacity: number;
+  /** Max open future orders per email address. */
+  maxOpenPerEmail: number;
+  /** Slot id of the current local time; orders in slots before it no longer count against the email limit. */
+  nowSlot: string;
+}
+
+/** "duplicate": the same form was already submitted as an open order (see `isResubmission`); nothing was inserted. */
+export type ReserveResult = "ok" | "slotFull" | "emailLimit" | { status: "duplicate"; order: Order };
+
+/** What a resubmission must share with the stored order to count as the same order. */
+export type OrderContent = Pick<Order, "token" | "slot" | "email" | "lines">;
+
+/**
+ * Synchronous on purpose: `reserve` checks the limits and inserts in one step, so two requests
+ * can never both take the last place in a slot.
+ */
+export interface OrderStore {
+  reserve(order: Order, limits: ReserveLimits): ReserveResult;
+  /** The open order this submission repeats, if any (same rule as the duplicate check in `reserve`). */
+  findDuplicate(order: OrderContent): Order | undefined;
+  cancel(id: string): void;
+  get(id: string): Order | undefined;
+  /** Number of open orders per slot id. */
+  countBySlot(): Record<string, number>;
+}
+
+function sameEmail(a: string, b: string): boolean {
+  return a.trim().toLowerCase() === b.trim().toLowerCase();
+}
+
+function lineKey(lines: OrderLine[]): string {
+  return lines
+    .map((l) => `${l.productId}:${l.qty}`)
+    .sort()
+    .join(",");
+}
+
+/**
+ * A resubmission of the same form (double click, reload, retry) has the same token AND the same content.
+ * Same token with a changed slot, email or items (e.g. after pressing Back and editing) is a new order.
+ */
+export function isResubmission(stored: Order, candidate: OrderContent): boolean {
+  return (
+    stored.status === "open" &&
+    candidate.token !== undefined &&
+    stored.token === candidate.token &&
+    stored.slot === candidate.slot &&
+    sameEmail(stored.email, candidate.email) &&
+    lineKey(stored.lines) === lineKey(candidate.lines)
+  );
+}
+
+export class InMemoryOrderStore implements OrderStore {
+  protected orders: Order[];
+
+  constructor(orders: Order[] = []) {
+    this.orders = orders;
+  }
+
+  reserve(order: Order, limits: ReserveLimits): ReserveResult {
+    // Checked first: the original submission may itself have taken the last place in the slot.
+    const duplicate = this.findDuplicate(order);
+    if (duplicate) return { status: "duplicate", order: duplicate };
+    const open = this.orders.filter((o) => o.status === "open");
+    if (open.filter((o) => o.slot === order.slot).length >= limits.capacity) return "slotFull";
+    const byEmail = open.filter((o) => o.slot > limits.nowSlot && sameEmail(o.email, order.email));
+    if (byEmail.length >= limits.maxOpenPerEmail) return "emailLimit";
+    this.orders.push(structuredClone(order));
+    return "ok";
+  }
+
+  findDuplicate(candidate: OrderContent): Order | undefined {
+    const order = this.orders.find((o) => isResubmission(o, candidate));
+    return order && structuredClone(order);
+  }
+
+  cancel(id: string): void {
+    const order = this.orders.find((o) => o.id === id);
+    if (order) order.status = "cancelled";
+  }
+
+  get(id: string): Order | undefined {
+    const order = this.orders.find((o) => o.id === id);
+    return order && structuredClone(order);
+  }
+
+  countBySlot(): Record<string, number> {
+    const counts: Record<string, number> = {};
+    for (const o of this.orders) if (o.status === "open") counts[o.slot] = (counts[o.slot] ?? 0) + 1;
+    return counts;
+  }
+}
+
+const StoredOrder = z.object({
+  id: z.string().regex(ORDER_ID_RE),
+  slot: z.string().regex(SLOT_ID_RE),
+  lines: z.array(
+    z.object({ productId: z.string(), qty: z.number().int().positive(), unitPriceCents: z.number().int().nonnegative() }),
+  ),
+  totalCents: z.number().int().nonnegative(),
+  name: z.string(),
+  email: z.string(),
+  phone: z.string().optional(),
+  note: z.string().optional(),
+  lang: z.enum(["sk", "en"]),
+  status: z.enum(["open", "cancelled"]),
+  createdAt: z.string(),
+  // Optional so files written before form tokens existed still load.
+  token: z.string().regex(FORM_TOKEN_RE).optional(),
+});
+
+function loadOrders(path: string): Order[] {
+  let raw: string;
+  try {
+    raw = readFileSync(path, "utf8");
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw err;
+  }
+  let data: unknown;
+  try {
+    data = JSON.parse(raw);
+  } catch (err) {
+    throw new Error(`Orders file ${path} is not valid JSON: ${(err as Error).message}`);
+  }
+  const parsed = z.array(StoredOrder).safeParse(data);
+  if (!parsed.success) {
+    const issue = parsed.error.issues[0];
+    throw new Error(`Orders file ${path} is not a valid list of orders: ${issue?.path.join(".")} ${issue?.message}`);
+  }
+  return parsed.data;
+}
+
+/**
+ * Keeps orders in memory and rewrites the whole JSON file (pretty-printed, so the shop can edit it by hand)
+ * after every change. Hand edits are picked up on restart; edit only while the server is stopped,
+ * otherwise the next order overwrites them.
+ */
+export class FileOrderStore extends InMemoryOrderStore {
+  constructor(private readonly path: string) {
+    super(loadOrders(path));
+  }
+
+  override reserve(order: Order, limits: ReserveLimits): ReserveResult {
+    const result = super.reserve(order, limits);
+    if (result === "ok") {
+      try {
+        this.save();
+      } catch (err) {
+        this.orders = this.orders.filter((o) => o.id !== order.id);
+        throw err;
+      }
+    }
+    return result;
+  }
+
+  override cancel(id: string): void {
+    const order = this.orders.find((o) => o.id === id);
+    if (!order || order.status === "cancelled") return;
+    super.cancel(id);
+    try {
+      this.save();
+    } catch (err) {
+      order.status = "open";
+      throw err;
+    }
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.path), { recursive: true });
+    const tmp = `${this.path}.${process.pid}.tmp`;
+    writeFileSync(tmp, `${JSON.stringify(this.orders, null, 2)}\n`);
+    renameSync(tmp, this.path);
+  }
+}
