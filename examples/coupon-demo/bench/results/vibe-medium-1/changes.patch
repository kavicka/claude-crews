index a2a65bc..114777e 100644
--- a/src/checkout.test.ts
+++ b/src/checkout.test.ts
@@ -27,4 +27,43 @@ describe("checkout", () => {
   it("rejects an unknown coupon", () => {
     expect(() => checkout(cart, "NOPE")).toThrow("Unknown coupon");
   });
+
+  it("accepts a single code inside an array", () => {
+    expect(checkout(cart, ["WELCOME10"]).discountCents).toBe(440);
+  });
+
+  it("treats an empty array like no coupon", () => {
+    expect(checkout(cart, []).discountCents).toBe(0);
+  });
+
+  it("stacks coupons in order, each on the remaining amount", () => {
+    // 4400 - 500 = 3900, then 10% of 3900 = 390
+    expect(checkout(cart, ["SAVE5", "WELCOME10"])).toEqual({
+      subtotalCents: 4400,
+      discountCents: 890,
+      taxCents: 702,
+      totalCents: 4212,
+    });
+    // 10% of 4400 = 440, then 500 (minimum checked against the subtotal)
+    expect(checkout(cart, ["WELCOME10", "SAVE5"]).discountCents).toBe(940);
+  });
+
+  it("never discounts below zero", () => {
+    const small = [{ sku: "pin", priceCents: 1000, qty: 1 }];
+    expect(checkout(small, ["GIFT25", "WELCOME10"])).toEqual({
+      subtotalCents: 1000,
+      discountCents: 1000,
+      taxCents: 0,
+      totalCents: 0,
+    });
+  });
+
+  it("rejects duplicate codes", () => {
+    expect(() => checkout(cart, ["WELCOME10", "WELCOME10"])).toThrow("Duplicate coupon");
+  });
+
+  it("rejects the whole checkout if any code is invalid", () => {
+    expect(() => checkout(cart, ["WELCOME10", "NOPE"])).toThrow("Unknown coupon");
+    expect(() => checkout(cart, ["SUMMER15"], new Date("2026-01-01"))).toThrow("Coupon expired");
+  });
 });
